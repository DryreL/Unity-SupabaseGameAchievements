# Auto detect text files and perform LF normalization
* text=auto eol=lf

# Web files explicitly forced to LF
*.html text eol=lf
*.htm text eol=lf
*.xml text eol=lf
*.svg text eol=lf
*.css text eol=lf
*.scss text eol=lf
*.js text eol=lf
*.json text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.md text eol=lf
*.markdown text eol=lf
*.txt text eol=lf
*.pub text eol=lf
*.txt text eol=lf
*.cs text eol=lf

# Windows batch files need CRLF
*.bat text eol=crlf
*.cmd text eol=crlf